# print(bool("0"), bool(0), str(3.14) == "3.14", int("3.14"))  # 输出？ int("3.14") -> ValueError
for i in range(1, 10):
    for j in range(1, i+1):
        print(f"{j} * {i} = {i*j}", end = "  ")
    print("\n")

# 左对齐示例
for i in range(1, 10):
    for j in range(1, i + 1):
        print(f"{j}×{i}={i*j:<4}", end="")  # <4表示左对齐占4位
    print()

# 居中对齐示例
for i in range(1, 10):
    for j in range(1, i + 1):
        print(f"{j}×{i}={i*j:^6}", end="")  # ^6表示居中对齐占6位
    print()
