import numpy as np
import pandas as pd
import re
from colour import (
    SpectralDistribution,
    sd_to_XYZ,
    XYZ_to_xy,
    xy_to_UCS_uv,
    sd_blackbody,
    colour_fidelity_index,
    SpectralShape
)
from scipy.optimize import minimize_scalar
from scipy.interpolate import interp1d
from scipy.integrate import trapezoid


def parse_float_with_unit(s):
    """从带单位的字符串中提取浮点数"""
    match = re.search(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", s)
    if not match:
        raise ValueError(f"字符串 '{s}' 中未找到有效数字")
    return float(match.group())


def triangle_perpendicular_interpolation(uv, min_temp=1000, max_temp=20000, step=50):
    """
    三角垂足插值法计算CCT (张浩2006)
    """
    temp_range = np.arange(min_temp, max_temp + step, step)
    bb_uv = np.array([xy_to_UCS_uv(XYZ_to_xy(sd_to_XYZ(sd_blackbody(T)))) for T in temp_range])

    # 找到曲线上最近的三个点
    distances = np.linalg.norm(bb_uv - uv, axis=1)
    min_index = np.argmin(distances)

    # 确定最近的两个点
    if min_index == 0:
        idx1, idx2 = 0, 1
    elif min_index == len(temp_range) - 1:
        idx1, idx2 = len(temp_range) - 2, len(temp_range) - 1
    else:
        if distances[min_index - 1] < distances[min_index + 1]:
            idx1, idx2 = min_index - 1, min_index
        else:
            idx1, idx2 = min_index, min_index + 1

    pointA = bb_uv[idx1]
    pointB = bb_uv[idx2]
    tempA = temp_range[idx1]
    tempB = temp_range[idx2]

    # 计算垂足和比例参数
    AB = pointB - pointA
    AC = uv - pointA
    t_param = np.dot(AC, AB) / np.dot(AB, AB)
    t_param = np.clip(t_param, 0, 1)

    # 计算垂足位置
    pointE = pointA + t_param * AB

    # 计算米勒德温度
    miredA = 1e6 / tempA
    miredB = 1e6 / tempB

    # 计算权重并插值
    distAE = t_param * np.linalg.norm(AB)
    distEB = (1 - t_param) * np.linalg.norm(AB)
    miredE = miredA + (distAE / (distAE + distEB)) * (miredB - miredA)

    # 米勒德转回色温
    cct_est = 1e6 / miredE

    # 使用优化方法精确化结果
    def dist_to_bb(T):
        bb_uv = xy_to_UCS_uv(XYZ_to_xy(sd_to_XYZ(sd_blackbody(T))))
        return np.linalg.norm(uv - bb_uv)

    result = minimize_scalar(
        dist_to_bb,
        bounds=(cct_est - 200, cct_est + 200),
        method='bounded'
    )

    refined_cct = result.x
    uv_bb = xy_to_UCS_uv(XYZ_to_xy(sd_to_XYZ(sd_blackbody(refined_cct))))

    return refined_cct, uv_bb


def calculate_duv(uv, uv_bb):
    """
    计算色偏差Duv (李月2023)
    """
    diff = uv - uv_bb
    distance = np.linalg.norm(diff)
    sign = np.sign(diff[1])
    return sign * distance


def calculate_tm30(test_spd):
    """
    计算TM-30的Rf和Rg
    """
    results = colour_fidelity_index(
        test_spd,
        method='ANSI/IES TM-30-18',
        additional_data=True
    )

    return results.R_f, results.R_g


def compute_mel_der(wavelengths, spd):
    """
    计算褪黑素日光照度比 (mel-DER)
    """
    # CIE 1931明视觉函数V(λ)
    v_lambda_data = {
        380: 0.0000, 385: 0.0001, 390: 0.0001, 395: 0.0002, 400: 0.0004,
        405: 0.0006, 410: 0.0010, 415: 0.0015, 420: 0.0021, 425: 0.0028,
        430: 0.0036, 435: 0.0046, 440: 0.0058, 445: 0.0071, 450: 0.0086,
        455: 0.0103, 460: 0.0121, 465: 0.0140, 470: 0.0160, 475: 0.0180,
        480: 0.0200, 485: 0.0220, 490: 0.0240, 495: 0.0260, 500: 0.0280,
        505: 0.0300, 510: 0.0320, 515: 0.0340, 520: 0.0360, 525: 0.0380,
        530: 0.0400, 535: 0.0420, 540: 0.0440, 545: 0.0460, 550: 0.0480,
        555: 0.0500, 560: 0.0520, 565: 0.0540, 570: 0.0560, 575: 0.0580,
        580: 0.0600, 585: 0.0620, 590: 0.0640, 595: 0.0660, 600: 0.0680,
        605: 0.0700, 610: 0.0720, 615: 0.0740, 620: 0.0760, 625: 0.0780,
        630: 0.0800, 635: 0.0820, 640: 0.0840, 645: 0.0860, 650: 0.0880,
        655: 0.0900, 660: 0.0920, 665: 0.0940, 670: 0.0960, 675: 0.0980,
        680: 0.1000, 685: 0.1020, 690: 0.1040, 695: 0.1060, 700: 0.1080,
        705: 0.1100, 710: 0.1120, 715: 0.1140, 720: 0.1160, 725: 0.1180,
        730: 0.1200, 735: 0.1220, 740: 0.1240, 745: 0.1260, 750: 0.1280,
        755: 0.1300, 760: 0.1320, 765: 0.1340, 770: 0.1360, 775: 0.1380,
        780: 0.1400
    }

    # CIE S 026视黑素权重函数s_mel(λ)
    s_mel_data = {
        380: 0.000, 385: 0.002, 390: 0.009, 395: 0.034, 400: 0.096,
        405: 0.200, 410: 0.328, 415: 0.455, 420: 0.567, 425: 0.676,
        430: 0.793, 435: 0.904, 440: 0.981, 445: 0.997, 450: 0.955,
        455: 0.878, 460: 0.777, 465: 0.652, 470: 0.520, 475: 0.395,
        480: 0.285, 485: 0.197, 490: 0.130, 495: 0.084, 500: 0.054,
        505: 0.036, 510: 0.025, 515: 0.018, 520: 0.014, 525: 0.011,
        530: 0.010, 535: 0.009, 540: 0.008, 545: 0.008, 550: 0.008,
        555: 0.008, 560: 0.008, 565: 0.008, 570: 0.008, 575: 0.008,
        580: 0.008, 585: 0.008, 590: 0.008, 595: 0.008, 600: 0.008,
        605: 0.007, 610: 0.007, 615: 0.007, 620: 0.007, 625: 0.006,
        630: 0.006, 635: 0.006, 640: 0.005, 645: 0.005, 650: 0.005,
        655: 0.004, 660: 0.004, 665: 0.004, 670: 0.003, 675: 0.003,
        680: 0.003, 685: 0.002, 690: 0.002, 695: 0.002, 700: 0.002,
        705: 0.001, 710: 0.001, 715: 0.001, 720: 0.001, 725: 0.001,
        730: 0.001, 735: 0.001, 740: 0.001, 745: 0.001, 750: 0.001,
        755: 0.001, 760: 0.001, 765: 0.001, 770: 0.000, 775: 0.000, 780: 0.000
    }

    # 创建数据框
    df_v_lambda = pd.DataFrame(list(v_lambda_data.items()), columns=['wavelength', 'V'])
    df_s_mel = pd.DataFrame(list(s_mel_data.items()), columns=['wavelength', 's_mel'])

    # 标准函数波长范围
    std_wavelengths = df_v_lambda['wavelength'].values

    # 计算有效范围
    start_wl = max(min(wavelengths), min(std_wavelengths))
    end_wl = min(max(wavelengths), max(std_wavelengths))

    if start_wl >= end_wl:
        raise ValueError(f"无有效波长范围交集: 输入范围[{min(wavelengths)}, {max(wavelengths)}] "
                         f"与标准范围[{min(std_wavelengths)}, {max(std_wavelengths)}]")

    # 筛选有效数据点
    valid_mask = (np.array(wavelengths) >= start_wl) & (np.array(wavelengths) <= end_wl)
    valid_wl = np.array(wavelengths)[valid_mask]
    valid_spd = np.array(spd)[valid_mask]

    # 创建插值函数
    v_lambda_interp = interp1d(df_v_lambda['wavelength'], df_v_lambda['V'],
                               bounds_error=False, fill_value=0)
    s_mel_interp = interp1d(df_s_mel['wavelength'], df_s_mel['s_mel'],
                            bounds_error=False, fill_value=0)

    # 在有效波长点计算函数值
    v_lambda_vals = v_lambda_interp(valid_wl)
    s_mel_vals = s_mel_interp(valid_wl)

    # 计算视黑素辐照度
    E_mel = trapezoid(valid_spd * s_mel_vals, valid_wl)

    # 计算照度
    K_m = 683  # 最大光视效能 (lm/W)
    E_v = K_m * trapezoid(valid_spd * v_lambda_vals, valid_wl)

    # 计算视黑素光辐射效能
    if E_v == 0:
        return 0.0
    K_mel_v = E_mel / E_v

    # 计算mel-DER
    K_mel_v_D65 = 0.00133  # D65标准值 (W/lm)
    mel_der = K_mel_v / K_mel_v_D65

    return mel_der


def main():
    # 读取SPD数据
    file_path = "附录.xlsx"
    try:
        spd_data = pd.read_excel(file_path, sheet_name="Problem 1")
    except Exception as e:
        print(f"文件读取错误: {e}")
        return

    # 创建光谱分布对象
    try:
        wavelengths = [parse_float_with_unit(str(w)) for w in spd_data.iloc[:, 0].values]
        spectral_power = spd_data.iloc[:, 1].values

        # 检查是否为理想格式 (380-780nm, 1nm间隔)
        is_ideal_format = (
                len(wavelengths) == 401 and
                wavelengths[0] == 380 and
                wavelengths[-1] == 780 and
                all(wavelengths[i + 1] - wavelengths[i] == 1 for i in range(len(wavelengths) - 1))
        )

        if is_ideal_format:
            print("提示: 原始数据已是380-780nm@1nm标准格式，插值不会改变数据")
        else:
            print("提示: 数据非标准格式，将进行插值处理")

        test_spd = SpectralDistribution(
            dict(zip(wavelengths, spectral_power)),
            name="Test SPD"
        )
        from colour import SpectralShape

        # 执行插值
        test_spd = test_spd.interpolate(SpectralShape(380, 780, 1))

    except Exception as e:
        print(f"光谱数据处理错误: {e}")
        return

    # ===== 核心修改：明确展示CIE XYZ色彩空间转换过程 =====
    print("\n===== CIE XYZ色彩空间转换 =====")

    # 1. 计算CIE XYZ三刺激值
    XYZ = sd_to_XYZ(test_spd)
    print(f"CIE XYZ三刺激值: X={XYZ[0]:.4f}, Y={XYZ[1]:.4f}, Z={XYZ[2]:.4f}")

    # 2. 转换为CIE xy色度坐标
    xy = XYZ_to_xy(XYZ)
    print(f"CIE xy色度坐标: x={xy[0]:.6f}, y={xy[1]:.6f}")

    # 3. 转换为CIE UCS 1960 uv色度坐标
    uv = xy_to_UCS_uv(xy)
    print(f"CIE UCS 1960 uv色度坐标: u={uv[0]:.6f}, v={uv[1]:.6f}")

    # ===== 基于CIE XYZ的结果计算相关色温 =====
    print("\n===== 相关色温计算 =====")
    print("通过三角垂足插值法寻找普朗克轨迹(黑体辐射轨迹)上最近点...")

    # 计算CCT和Duv
    CCT, uv_bb = triangle_perpendicular_interpolation(uv)
    Duv = calculate_duv(uv, uv_bb)

    print(f"找到最近点: CCT={CCT:.1f}K, 对应uv=({uv_bb[0]:.6f}, {uv_bb[1]:.6f})")
    print(f"色偏差Duv: {Duv:.6f} (正值表示在普朗克轨迹上方，负值表示在下方)")

    # 计算TM-30指标
    try:
        print("\n===== TM-30指标计算 =====")
        Rf, Rg = calculate_tm30(test_spd)
        print(f"保真度指数(Rf): {Rf:.2f}, 饱和度指数(Rg): {Rg:.2f}")
    except Exception as e:
        print(f"计算TM-30指标时出错: {e}")
        return

    # 计算mel-DER
    try:
        print("\n===== 褪黑素日光照度比计算 =====")
        mel_der = compute_mel_der(np.array(wavelengths), np.array(spectral_power))
        print(f"褪黑素日光照度比(mel-DER): {mel_der:.4f}")
    except Exception as e:
        print(f"计算mel-DER时出错: {e}")
        return

    print("\n===== 最终计算结果汇总 =====")
    print(f"相关色温(CCT): {CCT:.1f} K")
    print(f"色偏差(Duv): {Duv:.6f}")
    print(f"保真度指数(Rf): {Rf:.2f}")
    print(f"饱和度指数(Rg): {Rg:.2f}")
    print(f"褪黑素日光照度比(mel-DER): {mel_der:.4f}")


if __name__ == "__main__":
    main()